 linkedSpecimenId Specimen @relation("SpecimenAccess_specimenId", fields: [specimenId], references: [id], onDelete: Restrict)
 linkedBiobankCollectionId BiobankCollection @relation("SpecimenAccess_biobankCollectionId", fields: [biobankCollectionId], references: [id], onDelete: Restrict)
}

model MaterialAgreement {
 id String @id @default(cuid())
 title String
 accessRequestId String
 version String
 terms String
 expiresAt DateTime
 signatureEvidence String?
