 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([biobankCollectionId])
 linkedAccessRequestId AccessRequest @relation("MaterialAgreement_accessRequestId", fields: [accessRequestId], references: [id], onDelete: Restrict)
 linkedBiobankCollectionId BiobankCollection @relation("MaterialAgreement_biobankCollectionId", fields: [biobankCollectionId], references: [id], onDelete: Restrict)
