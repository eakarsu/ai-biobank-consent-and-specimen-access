 status String @default("Draft")
 biobankCollectionId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([biobankCollectionId])
 linkedBiobankCollectionId BiobankCollection @relation("RuleVersion_biobankCollectionId", fields: [biobankCollectionId], references: [id], onDelete: Restrict)
